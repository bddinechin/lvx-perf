# Python bytecode -- never commit these.
__pycache__/
*.pyc

# A half-written MANIFEST from an import that refused or was interrupted.
snapshots/*/MANIFEST.new

# gem5 run output. Sweeps are run in lvx-csw, not here, but the ISS drops an
# m5out/ wherever it is invoked from and a stray one must never be committed.
m5out/

# Personal scratch: a one-line `claude --resume <session-id>` reminder.
/RESUME

# The suites are submodules and ignore their own build output; a superproject
# .gitignore cannot reach inside a submodule regardless. Sweeps are run in
# them, so build artifacts land there, not here.

# Where lvx-csw is on THIS machine. lvx-perf measures a toolchain that lvx-csw
# builds, so every tool and harness here needs that path -- and it differs per
# machine, which is the whole reason it is a parameter and not a constant.
# Deliberately not committed: see bin/lvx-csw-path.
/lvx-csw.path
