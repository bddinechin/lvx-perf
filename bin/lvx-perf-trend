"""One metric per benchmark, across every snapshot that measured it.

  ./bin/lvx-perf-trend --suite polybench --config lvx-2-O2-mini-double
  ./bin/lvx-perf-trend --suite mibench --config lvx-2-O2 --metric cycles
  ./bin/lvx-perf-trend --suite polybench --config lvx-2-O2-mini-double --only gemm,syrk
  ./bin/lvx-perf-trend --suite ssw --config lvx-2-O2
  ./bin/lvx-perf-trend --suite turbopfor --config lvx-2-O2
  ./bin/lvx-perf-trend --suite polybench --config lvx-2-clang-O2-mini-double

Rows are benchmarks, columns are snapshot dates, and the last column is the
change from the first measurement to the latest. A cell is blank where that
snapshot did not run that benchmark -- suites gain and lose entries, and a gap
is not a zero.

Rows whose correctness column is not ok/fp-* are reported, never scored: on
this target a miscompile reads as a large speed-up, so an ungated number is
worse than no number.
"""

import argparse
import csv
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SNAPSHOTS = ROOT / "snapshots"

# What identifies a ROW differs per suite, and for one of them it is not a
# single column. turbopfor emits config x codec x width within one TSV -- the
# same codec at three widths, the same width under three build configs -- so
# keying on `config' alone would collapse six rows into three and silently
# report whichever came last.
#
# Only genuinely row-identifying columns belong here. arch, opt, dataset and
# type are also present but constant within a TSV (they are in its filename),
# so including them would add noise to every label.
KEY_COLUMNS = {
    "polybench": ("kernel",),
    "mibench":   ("benchmark",),
    "ssw":       ("bench",),
    "turbopfor": ("config", "codec", "width"),
    # tsvc2 emits one row per loop per vectorizer setting within a TSV, so the
    # loop name alone would collapse the vec/novec pair -- which is the pair
    # the suite exists to measure.
    "tsvc2":     ("loop", "vec"),
    # kernels runs one program per TSV, so `kernel' is constant in the file and
    # stays out by the rule above.  What varies is the 2x2 cross the suite
    # exists to measure, and both halves have to be in the key: FALLBACK_KEYS
    # would have found the constant `kernel' and collapsed all four rows onto
    # one label.
    "kernels":   ("spec", "vec"),
}
# For a suite not listed, fall back to the first single column that exists --
# enough for any harness that follows the one-row-per-benchmark convention.
FALLBACK_KEYS = ("kernel", "benchmark", "bench", "config")
# lvx-ssw's headline is cycles per cell update, not raw cycles: it is the
# quantity that compares to a published GCUPS figure with the clock divided
# out, and its two benchmarks run different cell counts.
DEFAULT_METRIC = {
    "polybench": "kernel_cycles",
    "mibench": "cycles",
    "ssw": "cycles_per_cell",
    "turbopfor": "cycles_per_int",
    "tsvc2":     "cycles",
    "kernels":   "cycles",
}


def is_correct(value):
    """Correctness verdicts that permit scoring.

    'noref' means no reference output was shipped or generated -- the run is
    real but unchecked, so it is kept and flagged rather than silently scored.
    'static' (lvx-ssw) is a build-only row with no cycles at all, and the fp-*
    classes are PolyBench/MiBench floating-point last-place drift, which an
    integer kernel never reports.
    """
    return value == "ok" or value.startswith("fp-")


def read_tsv(path, metric, suite):
    """-> (rows: {row-label: (value, verdict)}, missing_metric: bool)"""
    rows = {}
    with path.open(newline="") as fh:
        reader = csv.DictReader(fh, delimiter="\t")
        if reader.fieldnames is None:
            return rows, True
        wanted = KEY_COLUMNS.get(suite)
        if wanted is not None:
            keys = [c for c in wanted if c in reader.fieldnames]
        else:
            keys = [c for c in FALLBACK_KEYS if c in reader.fieldnames][:1]
        if not keys or metric not in reader.fieldnames:
            return rows, True
        for row in reader:
            # Joined with "/" so a composite label reads as one name and sorts
            # by config then codec then width, which is the order a reader
            # wants to compare in.
            name = "/".join((row.get(k) or "").strip() for k in keys).strip("/")
            raw = (row.get(metric) or "").strip()
            if not name or not raw:
                continue
            try:
                value = float(raw)
            except ValueError:
                continue
            rows[name] = (value, (row.get("correct") or "").strip())
    return rows, False


def read_manifest(snap):
    """The provenance line, and the revisions that decide comparability.

    A trend puts numbers from different days in one table, which silently
    assumes they measure the same thing. Two revisions decide whether they do,
    and they are not alike:

      lvx-gcc   Codegen. A change here is usually the POINT -- the column is
                there to show what the compiler did -- so it is reported, not
                warned about.
      lvx-gem5  The ISS timing model, which decides every cycle count. A
                change here can rescale a whole suite with the checksums
                unmoved, and NOT by one factor. Re-measuring lvx-ssw across
                one such change moved its three benchmarks by 2.42x, 3.12x
                and 4.00x, every checksum identical -- so relative costs
                changed, and the byte-gather penalty the suite exists to
                price went from 14.2x to 18.3x. Nothing in the numbers looks
                wrong, which is what makes it worth a warning.
    """
    out = {"provenance": "?", "lvx-gem5": "", "lvx-gcc/gcc": ""}
    path = snap / "MANIFEST"
    if not path.is_file():
        return out
    for line in path.read_text(encoding="utf-8").splitlines():
        if line.startswith("#"):
            continue
        parts = line.rstrip("\n").split("\t")
        if len(parts) < 2:
            continue
        if parts[0] == "provenance":
            out["provenance"] = parts[1]
        elif parts[0] in ("lvx-gem5", "lvx-gcc/gcc"):
            out[parts[0]] = parts[1][:10]
    return out


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--suite", required=True, help="polybench | mibench")
    ap.add_argument("--config", required=True,
                    help="TSV basename without .tsv, e.g. lvx-2-O2-mini-double")
    ap.add_argument("--metric", help="column to track (suite-specific default)")
    ap.add_argument("--only", help="comma-separated benchmark subset")
    args = ap.parse_args()

    metric = args.metric or DEFAULT_METRIC.get(args.suite)
    if not metric:
        ap.error(f"no default metric for suite '{args.suite}'; pass --metric")

    if not SNAPSHOTS.is_dir():
        sys.exit(f"no snapshots/ directory at {SNAPSHOTS}")

    dates, per_date, flagged, skipped = [], {}, {}, []
    for snap in sorted(SNAPSHOTS.iterdir()):
        tsv = snap / args.suite / f"{args.config}.tsv"
        if not tsv.is_file():
            continue
        rows, bad_header = read_tsv(tsv, metric, args.suite)
        if bad_header:
            skipped.append(f"{snap.name}: no '{metric}' column")
            continue
        if not rows:
            continue
        dates.append(snap.name)
        per_date[snap.name] = rows
        for name, (_, verdict) in rows.items():
            if not is_correct(verdict):
                flagged.setdefault(name, set()).add(verdict or "?")

    if not dates:
        sys.exit(f"no snapshot has {args.suite}/{args.config}.tsv "
                 f"with a '{metric}' column")

    names = sorted({n for rows in per_date.values() for n in rows})
    if args.only:
        wanted = {s.strip() for s in args.only.split(",") if s.strip()}
        unknown = wanted - set(names)
        if unknown:
            sys.exit("not measured in any snapshot: " + ", ".join(sorted(unknown)))
        names = [n for n in names if n in wanted]

    # Cycle counts are large integers and want thousands separators; a derived
    # ratio like cycles_per_cell is near 1-10, where "%.0f" would quantise the
    # entire measurement away -- 2.850 and 11.386 printed as 3 and 11. Decide
    # from the data rather than from a list of metric names, so a new derived
    # metric formats correctly without being registered anywhere.
    allv = [v for rows in per_date.values() for (v, _) in rows.values()]
    small = bool(allv) and max(abs(v) for v in allv) < 1000
    fmt = (lambda v: f"{v:,.3f}") if small else (lambda v: f"{v:,.0f}")

    width = max([len(n) for n in names] + [len("benchmark")])
    cols = [max(len(d), 12) for d in dates]
    header = "benchmark".ljust(width) + "  " + "  ".join(
        d.rjust(w) for d, w in zip(dates, cols)) + "  " + "change".rjust(9)
    print(f"{args.suite}/{args.config}  metric={metric}  "
          f"(lower is better, {len(dates)} snapshot(s))\n")

    # What the columns were measured with, before the numbers that invite
    # comparing them. A trend table is the one place a provenance field has to
    # be read, because putting two snapshots side by side is the claim that
    # they are commensurable.
    manifests = {d: read_manifest(SNAPSHOTS / d) for d in dates}
    unproven = [d for d in dates if manifests[d]["provenance"] != "exact"]
    if unproven:
        print("  provenance: " + ", ".join(
            f"{d} {manifests[d]['provenance']}" for d in unproven))
    gem5 = {manifests[d]["lvx-gem5"] for d in dates if manifests[d]["lvx-gem5"]}
    gcc = {manifests[d]["lvx-gcc/gcc"] for d in dates if manifests[d]["lvx-gcc/gcc"]}
    if len(gem5) > 1:
        print("  WARNING: lvx-gem5 differs across these columns (" +
              ", ".join(sorted(gem5)) + ").")
        print("           The ISS timing model decides every cycle count here, so a")
        print("           change between columns may be the model and not the code.")
        print("           Measured: one such change rescaled lvx-ssw's three")
        print("           benchmarks by 2.42x, 3.12x and 4.00x -- DIFFERENT factors,")
        print("           every checksum unmoved. So it moves rankings, not just")
        print("           magnitudes: the byte-gather penalty read 14.2x before and")
        print("           18.3x after. Compare within one revision.")
    if len(gcc) > 1:
        print("  note: lvx-gcc differs across these columns (" +
              ", ".join(sorted(gcc)) + ") -- expected, and usually the point.")
    if unproven or len(gem5) > 1 or len(gcc) > 1:
        print()
    print(header)
    print("-" * len(header))

    for name in names:
        cells, series = [], []
        for date, w in zip(dates, cols):
            entry = per_date[date].get(name)
            if entry is None:
                cells.append("".rjust(w))
            else:
                value = entry[0]
                series.append(value)
                cells.append(fmt(value).rjust(w))
        # Compare first measured against last measured, not first against
        # first column: a benchmark added later still has a usable series.
        if len(series) >= 2 and series[0]:
            delta = (series[-1] - series[0]) / series[0] * 100.0
            change = f"{delta:+.1f}%".rjust(9)
        else:
            change = "-".rjust(9)
        mark = " *" if name in flagged else ""
        print(name.ljust(width) + "  " + "  ".join(cells) + "  " + change + mark)

    if flagged:
        print("\n* not correctness-gated -- reported, not a performance result:")
        for name in sorted(flagged):
            print(f"    {name}: {', '.join(sorted(flagged[name]))}")
    for note in skipped:
        print(f"\nskipped {note}", file=sys.stderr)


if __name__ == "__main__":
    main()
