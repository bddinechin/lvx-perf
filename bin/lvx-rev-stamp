#!/usr/bin/env bash
#
# The revisions that define a measurement, as TSV columns.
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
#
# Usage:
#   lvx-rev-stamp --tsv-header            # the column names
#   lvx-rev-stamp --tsv-row [--csw PATH]  # the values, same order
#   lvx-rev-stamp --check [--csw PATH]    # is a sweep worth starting?
#
# --check answers the question a harness should ask BEFORE it measures, not
# after: will these numbers be attributable? It exits non-zero when they will
# not. It does not refuse anything -- measuring against your own dirty backend
# to see whether a change helped is the normal development loop, and the right
# thing to do -- but a sweep is minutes to hours, and learning afterwards that
# every row says `-dirty' wastes all of it. Three independent row sets stamped
# themselves unattributable in two days before this existed.
#
# A harness calls both and pastes them into its header and its rows, so a
# number carries the toolchain that produced it. ONE script owns both halves
# deliberately: a harness that spelled the header itself would drift from the
# row on the next column added, and a shifted field is the kind of bug that
# reads as data rather than failing (lvx-tsvc2's cms-probe.sh shipped exactly
# that once, a printf whose arguments slid by one).
#
# Why these four:
#
#   csw_rev   The superproject pin, which names every component at once -- but
#             only if its gitlinks are current, so it cannot stand alone.
#   gcc_rev   Codegen. The reason this file exists: lvx-gcc moved twice in one
#             evening across a run of pipeliner and register-allocator fixes,
#             and the `toolchain' version string (17.0.0 20260627) did not
#             change through any of it. A baked version date cannot carry
#             provenance.
#   gem5_rev  Cycles. A timing-model change rescaled lvx-ssw by 4.002x with an
#             identical checksum -- the numbers stayed plausible and became
#             incomparable, which is the worst way for a record to break.
#   cc_mtime  The installed binary's mtime, because no SHA catches a toolchain
#             reinstalled in place from an uncommitted tree. That happened
#             during lvx-kernels' first sweep, between two of four
#             configurations.
#
# A `-dirty' suffix means tracked files differed from the revision named.
# `unknown' means it could not be determined -- a standalone checkout with no
# superproject, say -- and is deliberately not an error: a harness must still
# run, it just cannot promise provenance, and lvx-perf-import is the thing
# that refuses to call an unverifiable sweep exact.
set -u

COLUMNS="csw_rev	gcc_rev	gem5_rev	cc_mtime"

mode= CSW_ARG=
while [ $# -gt 0 ]; do
    case "$1" in
        --tsv-header) mode=header; shift ;;
        --tsv-row)    mode=row; shift ;;
        --check)      mode=check; shift ;;
        --csw)        CSW_ARG="${2:?--csw needs a path}"; shift 2 ;;
        --csw=*)      CSW_ARG="${1#--csw=}"; shift ;;
        -h|--help)    sed -n '3,36p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *)            echo "lvx-rev-stamp: unknown argument: $1" >&2; exit 2 ;;
    esac
done
[ -n "$mode" ] || { echo "lvx-rev-stamp: need --tsv-header, --tsv-row or --check" >&2; exit 2; }

if [ "$mode" = header ]; then
    printf '%s\n' "$COLUMNS"
    exit 0
fi

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

CSW=
if [ -n "$CSW_ARG" ]; then
    CSW=$CSW_ARG
elif resolved=$("$HERE/bin/lvx-csw-path" ${CSW_ARG:+--csw "$CSW_ARG"} 2>/dev/null); then
    CSW=$resolved
fi

# Short SHA plus a -dirty marker, or `unknown'. Never fails: an unresolvable
# component is a weaker record, not a dead harness.
rev_of() {
    local repo=$1 sha
    [ -n "$repo" ] && [ -e "$repo/.git" ] || { printf 'unknown'; return; }
    sha=$(git -C "$repo" rev-parse --short HEAD 2>/dev/null) || { printf 'unknown'; return; }
    # TRACKED modifications only, matching --check exactly. These two must
    # agree: --check said clean while this said -dirty, so a campaign passed
    # the pre-flight gate and then stamped every row -dirty, which
    # bin/lvx-stamp-check reads as a disagreement and the import refuses.
    # The pre-flight check exists to stop a sweep wasting hours; two
    # different definitions of dirty inside one script defeated it.
    [ -n "$(git -C "$repo" status --porcelain --untracked-files=no 2>/dev/null | head -1)" ] \
        && sha="$sha-dirty"
    printf '%s' "$sha"
}

cc_mtime_of() {
    local cc=$1
    [ -x "$cc" ] || { printf 'unknown'; return; }
    date -r "$cc" +%Y-%m-%dT%H:%M:%S 2>/dev/null || printf 'unknown'
}

stamp_row_for_selfcheck() {
    printf '%s\t%s\t%s\t%s' \
        "$(rev_of "$CSW")" \
        "$(rev_of "${CSW:+$CSW/lvx-gcc/gcc}")" \
        "$(rev_of "${CSW:+$CSW/lvx-gem5}")" \
        "$(cc_mtime_of "${CSW:+$CSW/lvx-toolchain/bin/lvx-mbr-gcc}")"
}

if [ "$mode" = check ]; then
    rc=0
    if [ -z "$CSW" ]; then
        echo "lvx-csw: NOT FOUND (see bin/lvx-csw-path)"
        echo "=> rows measured now will stamp \`unknown' and cannot be verified."
        exit 1
    fi
    # Report each component, and say which ones are dirty. A dirty tree is the
    # disqualifying state: bin/lvx-stamp-check treats a -dirty stamp as a
    # disagreement, because the revision it names does not identify what ran.
    for c in "" lvx-gcc/gcc lvx-gem5 lvx-mds; do
        repo=${c:+$CSW/$c}; repo=${repo:-$CSW}
        label=${c:-lvx-csw}
        [ -e "$repo/.git" ] || { printf '  %-14s absent\n' "$label"; continue; }
        sha=$(git -C "$repo" rev-parse --short HEAD 2>/dev/null || echo unknown)
        # TRACKED modifications only. An untracked file does not change what
        # the compiler was built from -- nothing references it -- so it must
        # not gate a sweep. Counting it did: a stray `?? validation/run' in
        # lvx-csw held this check at DIRTY for three days and blocked a
        # campaign waiting on it. Untracked files are still reported, because
        # a stray source file in a tree that globs would be a real risk, but
        # they are a remark and not a verdict.
        dirt=$(git -C "$repo" status --porcelain --untracked-files=no 2>/dev/null | wc -l)
        untr=$(git -C "$repo" ls-files --others --exclude-standard 2>/dev/null | wc -l)
        note=""
        [ "$untr" -gt 0 ] && note="  (+$untr untracked, not gating)"
        if [ "$dirt" -gt 0 ]; then
            printf '  %-14s %-13s DIRTY (%s tracked)%s\n' "$label" "$sha" "$dirt" "$note"
            rc=1
        else
            printf '  %-14s %-13s clean%s\n' "$label" "$sha" "$note"
        fi
    done
    # The installed binaries, because neither is a revision. A toolchain or an
    # ISS copied into place leaves every SHA untouched, and the ISS binary in
    # particular decides every cycle count. A recent mtime means a rebuild may
    # still be in flight.
    now=$(date +%s)
    for b in lvx-toolchain/bin/lvx-mbr-gcc lvx-gem5/build/gem5-lvx-1.opt \
             lvx-gem5/build/gem5-lvx-2.opt; do
        f=$CSW/$b
        [ -e "$f" ] || { printf '  %-14s absent: %s\n' installed "$b"; continue; }
        t=$(date -r "$f" +%s 2>/dev/null) || continue
        age=$(( (now - t) / 60 ))
        warn=""
        [ "$age" -lt 10 ] && { warn="  <-- rebuilt in the last 10 min; a build may be in flight"; rc=1; }
        printf '  %-14s %s  (%sm ago)%s\n' installed "$(basename "$b")" "$age" "$warn"
    done
    # Is the INSTALLED binary actually built from what is on disk now?
    #
    # This is the hole the other two checks leave. A clean tree and a binary
    # older than ten minutes say nothing about whether that binary was built
    # from the current sources -- and the stamp records the TREE's SHA. So a
    # sweep could run a gem5 built before four model commits while every row
    # claimed the current lvx-gem5 revision. That is not a weak record, it is
    # a confident false one, and bin/lvx-perf-import cannot catch it: the
    # trees really are clean, so there is nothing to refuse.
    #
    # The comparison is against FILE mtimes, not commit dates. An earlier
    # version of this compared the binary against `git log --since', and that
    # cannot tell "built before the change existed" from "built from the
    # change before it was committed" -- build, measure, then commit is the
    # ordinary order when a measurement gates the commit, and it made this
    # check cry wolf on a compiler that already contained the change, 87
    # seconds ahead of its own commit. File mtimes also catch what commit
    # dates miss entirely: a binary built from edits that were never
    # committed at all, which looks current and is not.
    stale_against() {   # $1 = binary, $2 = repo, $3 = find paths (one string)
        local bin=$1 repo=$2 paths=$3 newer
        [ -e "$CSW/$bin" ] || return 0
        [ -d "$CSW/$repo" ] || return 0
        # eval so the path list may carry globs; every list below is a literal
        # in this file, never anything a caller supplies.
        newer=$(cd "$CSW/$repo" 2>/dev/null \
                && eval "find $paths -type f -newer '$CSW/$bin' 2>/dev/null" | head -4)
        [ -z "$newer" ] && return 0
        printf '  %-14s %s predates %s sources it is built from:\n' \
            STALE "$(basename "$bin")" "$repo"
        printf '%s\n' "$newer" | sed 's|^|                   |'
        return 1
    }
    for b in lvx-gem5/build/gem5-lvx-1.opt lvx-gem5/build/gem5-lvx-2.opt; do
        stale_against "$b" lvx-gem5 'src configs SConstruct site_scons' || rc=1
    done
    stale_against lvx-toolchain/bin/lvx-mbr-gcc lvx-gcc/gcc \
        'gcc/config/lvx gcc/*.cc gcc/*.h' || rc=1

    # Separately: is the GENERATED backend behind the description it comes
    # from? lvx-gem5's src/arch/lvx/generated/* are gitignored MDS products,
    # so they are invisible to every revision check, and lvx-mds moving means
    # they must be regenerated rather than merely recompiled. Reported and not
    # prescribed, because regenerating BE/GEM5 from anywhere but the top level
    # silently prunes opcodes and changes ISS semantics -- so the cheap fix
    # and the dangerous one differ, and a tool should not pick.
    gen=$CSW/lvx-gem5/src/arch/lvx/generated
    if [ -d "$gen" ] && [ -d "$CSW/lvx-mds" ]; then
        newest_gen=$(find "$gen" -type f -printf '%T@\n' 2>/dev/null | sort -rn | head -1)
        if [ -n "${newest_gen:-}" ]; then
            mds_newer=$(cd "$CSW/lvx-mds" \
                && find . -type f -newermt "@${newest_gen%.*}" \
                   -not -path './.git/*' 2>/dev/null | head -3)
            if [ -n "$mds_newer" ]; then
                printf '  %-14s lvx-mds is newer than the generated backend:\n' REGEN
                printf '%s\n' "$mds_newer" | sed 's|^|                   |'
                echo   "                   regenerate from the lvx-mds TOP LEVEL only"
                rc=1
            fi
        fi
    fi

    # Self-check: --check and --tsv-row must agree about what dirty means.
    # They did not, once -- --check reported clean while --tsv-row appended
    # -dirty from untracked files -- and a campaign passed this gate, swept,
    # and would have had its import refused. A gate that can disagree with
    # the thing it is gating is worse than no gate, because it is trusted.
    if [ "$rc" = 0 ] && printf '%s' "$(stamp_row_for_selfcheck)" | grep -q -- '-dirty'; then
        echo "=> TOOL BUG: --check says clean but --tsv-row stamps -dirty:"
        echo "     $(stamp_row_for_selfcheck)"
        echo "   Do not trust either answer until they agree."
        exit 1
    fi
    if [ "$rc" = 0 ]; then
        echo "=> provenance-clean: a sweep now can earn provenance=exact."
    else
        echo "=> NOT provenance-clean. Fine for development; not for a series."
        echo "   A DIRTY tree makes the stamp say -dirty, which the import refuses."
        echo "   A STALE binary is worse and the import cannot catch it: the trees"
        echo "   are clean, so every row would record the current SHA while having"
        echo "   run a binary built from an older one. Rebuild, or do not publish"
        echo "   the rows as a series."
    fi
    exit $rc
fi

printf '%s\t%s\t%s\t%s\n' \
    "$(rev_of "$CSW")" \
    "$(rev_of "${CSW:+$CSW/lvx-gcc/gcc}")" \
    "$(rev_of "${CSW:+$CSW/lvx-gem5}")" \
    "$(cc_mtime_of "${CSW:+$CSW/lvx-toolchain/bin/lvx-mbr-gcc}")"
