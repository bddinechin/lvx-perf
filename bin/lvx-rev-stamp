#!/usr/bin/env bash
#
# The revisions that define a measurement, as TSV columns.
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
#
# Usage:
#   lvx-rev-stamp --tsv-header            # the column names
#   lvx-rev-stamp --tsv-row [--csw PATH]  # the values, same order
#   lvx-rev-stamp --check [--csw PATH]    # is a sweep worth starting?
#
# --check answers the question a harness should ask BEFORE it measures, not
# after: will these numbers be attributable? It exits non-zero when they will
# not. It does not refuse anything -- measuring against your own dirty backend
# to see whether a change helped is the normal development loop, and the right
# thing to do -- but a sweep is minutes to hours, and learning afterwards that
# every row says `-dirty' wastes all of it. Three independent row sets stamped
# themselves unattributable in two days before this existed.
#
# A harness calls both and pastes them into its header and its rows, so a
# number carries the toolchain that produced it. ONE script owns both halves
# deliberately: a harness that spelled the header itself would drift from the
# row on the next column added, and a shifted field is the kind of bug that
# reads as data rather than failing (lvx-tsvc2's cms-probe.sh shipped exactly
# that once, a printf whose arguments slid by one).
#
# Why these four:
#
#   csw_rev   The superproject pin, which names every component at once -- but
#             only if its gitlinks are current, so it cannot stand alone.
#   gcc_rev   Codegen. The reason this file exists: lvx-gcc moved twice in one
#             evening across a run of pipeliner and register-allocator fixes,
#             and the `toolchain' version string (17.0.0 20260627) did not
#             change through any of it. A baked version date cannot carry
#             provenance.
#   gem5_rev  Cycles. A timing-model change rescaled lvx-ssw by 4.002x with an
#             identical checksum -- the numbers stayed plausible and became
#             incomparable, which is the worst way for a record to break.
#   cc_mtime  The installed binary's mtime, because no SHA catches a toolchain
#             reinstalled in place from an uncommitted tree. That happened
#             during lvx-kernels' first sweep, between two of four
#             configurations.
#
# A `-dirty' suffix means tracked files differed from the revision named.
# `unknown' means it could not be determined -- a standalone checkout with no
# superproject, say -- and is deliberately not an error: a harness must still
# run, it just cannot promise provenance, and lvx-perf-import is the thing
# that refuses to call an unverifiable sweep exact.
set -u

COLUMNS="csw_rev	gcc_rev	gem5_rev	cc_mtime"

mode= CSW_ARG=
while [ $# -gt 0 ]; do
    case "$1" in
        --tsv-header) mode=header; shift ;;
        --tsv-row)    mode=row; shift ;;
        --check)      mode=check; shift ;;
        --csw)        CSW_ARG="${2:?--csw needs a path}"; shift 2 ;;
        --csw=*)      CSW_ARG="${1#--csw=}"; shift ;;
        -h|--help)    sed -n '3,36p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *)            echo "lvx-rev-stamp: unknown argument: $1" >&2; exit 2 ;;
    esac
done
[ -n "$mode" ] || { echo "lvx-rev-stamp: need --tsv-header, --tsv-row or --check" >&2; exit 2; }

if [ "$mode" = header ]; then
    printf '%s\n' "$COLUMNS"
    exit 0
fi

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

CSW=
if [ -n "$CSW_ARG" ]; then
    CSW=$CSW_ARG
elif resolved=$("$HERE/bin/lvx-csw-path" ${CSW_ARG:+--csw "$CSW_ARG"} 2>/dev/null); then
    CSW=$resolved
fi

# Short SHA plus a -dirty marker, or `unknown'. Never fails: an unresolvable
# component is a weaker record, not a dead harness.
rev_of() {
    local repo=$1 sha
    [ -n "$repo" ] && [ -e "$repo/.git" ] || { printf 'unknown'; return; }
    sha=$(git -C "$repo" rev-parse --short HEAD 2>/dev/null) || { printf 'unknown'; return; }
    [ -n "$(git -C "$repo" status --porcelain 2>/dev/null | head -1)" ] && sha="$sha-dirty"
    printf '%s' "$sha"
}

cc_mtime_of() {
    local cc=$1
    [ -x "$cc" ] || { printf 'unknown'; return; }
    date -r "$cc" +%Y-%m-%dT%H:%M:%S 2>/dev/null || printf 'unknown'
}

if [ "$mode" = check ]; then
    rc=0
    if [ -z "$CSW" ]; then
        echo "lvx-csw: NOT FOUND (see bin/lvx-csw-path)"
        echo "=> rows measured now will stamp \`unknown' and cannot be verified."
        exit 1
    fi
    # Report each component, and say which ones are dirty. A dirty tree is the
    # disqualifying state: bin/lvx-stamp-check treats a -dirty stamp as a
    # disagreement, because the revision it names does not identify what ran.
    for c in "" lvx-gcc/gcc lvx-gem5 lvx-mds; do
        repo=${c:+$CSW/$c}; repo=${repo:-$CSW}
        label=${c:-lvx-csw}
        [ -e "$repo/.git" ] || { printf '  %-14s absent\n' "$label"; continue; }
        sha=$(git -C "$repo" rev-parse --short HEAD 2>/dev/null || echo unknown)
        dirt=$(git -C "$repo" status --porcelain 2>/dev/null | wc -l)
        if [ "$dirt" -gt 0 ]; then
            printf '  %-14s %-13s DIRTY (%s file(s))\n' "$label" "$sha" "$dirt"
            rc=1
        else
            printf '  %-14s %-13s clean\n' "$label" "$sha"
        fi
    done
    # The installed binaries, because neither is a revision. A toolchain or an
    # ISS copied into place leaves every SHA untouched, and the ISS binary in
    # particular decides every cycle count. A recent mtime means a rebuild may
    # still be in flight.
    now=$(date +%s)
    for b in lvx-toolchain/bin/lvx-mbr-gcc lvx-gem5/build/gem5-lvx-1.opt \
             lvx-gem5/build/gem5-lvx-2.opt; do
        f=$CSW/$b
        [ -e "$f" ] || { printf '  %-14s absent: %s\n' installed "$b"; continue; }
        t=$(date -r "$f" +%s 2>/dev/null) || continue
        age=$(( (now - t) / 60 ))
        warn=""
        [ "$age" -lt 10 ] && { warn="  <-- rebuilt in the last 10 min; a build may be in flight"; rc=1; }
        printf '  %-14s %s  (%sm ago)%s\n' installed "$(basename "$b")" "$age" "$warn"
    done
    if [ "$rc" = 0 ]; then
        echo "=> provenance-clean: a sweep now can earn provenance=exact."
    else
        echo "=> NOT provenance-clean. Rows measured now will stamp \`-dirty' and"
        echo "   bin/lvx-perf-import will refuse them. Fine for development; not"
        echo "   for a series. Wait for the trees to settle, or accept it."
    fi
    exit $rc
fi

printf '%s\t%s\t%s\t%s\n' \
    "$(rev_of "$CSW")" \
    "$(rev_of "${CSW:+$CSW/lvx-gcc/gcc}")" \
    "$(rev_of "${CSW:+$CSW/lvx-gem5}")" \
    "$(cc_mtime_of "${CSW:+$CSW/lvx-toolchain/bin/lvx-mbr-gcc}")"
