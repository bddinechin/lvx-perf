#!/usr/bin/env bash
# Part of the LVX project, under the Apache License v2.0 with LLVM Exceptions.
# See LICENSE.TXT in the root of this repository for license information.
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception

# Snapshot a benchmark sweep into snapshots/<date>/, stamped with the revisions
# that produced it.
#
#   ./bin/lvx-perf-import                    # today's date, every suite
#   ./bin/lvx-perf-import --date 2026-10-14  # back-date (use the sweep's date)
#   ./bin/lvx-perf-import --suite polybench
#   ./bin/lvx-perf-import --csw /path/to/lvx-csw
#   LVX_CSW=/path/to/lvx-csw ./bin/lvx-perf-import
#
# The benchmark suites are submodules of THIS repository, so a sweep's results
# are read from ./lvx-<suite>/results. The compilers are not: they live in
# lvx-csw, whose location is a parameter -- see bin/lvx-csw-path for the
# resolution chain, which every tool and harness here shares.
#
# A results TSV on its own is not a performance record. The ISS is
# deterministic, so the same ELF gives the same cycle count forever; a number
# only means something next to the compiler that emitted it. That is what
# MANIFEST carries, and why import refuses to run against a dirty input tree.

set -euo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

DATE=$(date +%F)
SUITES=""
CSW_ARG=${LVX_CSW:-}
ALLOW_DIRTY=${ALLOW_DIRTY:-0}

while [ $# -gt 0 ]; do
    case "$1" in
        --date)        DATE="$2"; shift 2 ;;
        --suite)       SUITES="$SUITES $2"; shift 2 ;;
        --csw)         CSW_ARG="$2"; shift 2 ;;
        --csw=*)       CSW_ARG="${1#--csw=}"; shift ;;
        --allow-dirty) ALLOW_DIRTY=1; shift ;;
        -h|--help)     sed -n '6,22p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *)             echo "unknown argument: $1" >&2; exit 2 ;;
    esac
done

[ -n "$SUITES" ] || SUITES="polybench mibench ssw"

case "$DATE" in
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
    *) echo "--date wants YYYY-MM-DD, got '$DATE'" >&2; exit 2 ;;
esac

# Locate lvx-csw for the toolchain revisions, by the one chain every tool and
# harness here shares: --csw, $LVX_CSW, lvx-csw.path, ../lvx-csw, ~/lvx-csw.
# bin/lvx-csw-path owns it so there is a single place to change it, and a
# single place that documents it.
CSW= CSW_FROM=
if resolved=$("$HERE/bin/lvx-csw-path" --from ${CSW_ARG:+--csw "$CSW_ARG"} 2>/dev/null); then
    CSW=${resolved%%$'\t'*}
    CSW_FROM=${resolved##*$'\t'}
fi

# A component's revision, plus whether its tracked state is dirty. Benchmark
# repositories are asked about their source only: `results/` is this sweep's
# output, and an uncommitted result must not be mistaken for a changed input.
describe_at() {
    local repo=$1 kind=$2 sha desc dirt
    if [ ! -e "$repo/.git" ]; then
        printf 'absent\tabsent\n'
        return
    fi
    sha=$(git -C "$repo" rev-parse HEAD 2>/dev/null || echo unknown)
    desc=$(git -C "$repo" describe --always 2>/dev/null || echo unknown)
    if [ "$kind" = benchmark ]; then
        dirt=$(git -C "$repo" status --porcelain -- . ':(exclude)results' 2>/dev/null | head -1)
    else
        dirt=$(git -C "$repo" status --porcelain 2>/dev/null | head -1)
    fi
    [ -n "$dirt" ] && desc="$desc-dirty"
    printf '%s\t%s\n' "$sha" "$desc"
}

if [ "$DATE" = "$(date +%F)" ]; then
    PROVENANCE=exact
else
    PROVENANCE=as-of-import
fi

DEST="$HERE/snapshots/$DATE"
mkdir -p "$DEST"

# MANIFEST.new is provenance that has not yet been accepted. If this script
# dies or is interrupted before the mv below, it must not survive: a stray
# half-written manifest in a snapshot directory reads like a real record, and
# it is gitignored, so nothing would draw attention to it.
trap 'rm -f "$DEST/MANIFEST.new"; rmdir "$DEST" 2>/dev/null || true' EXIT

{
    echo "# LVX performance snapshot -- provenance for the TSVs beside this file."
    echo "# Written by bin/lvx-perf-import; edit only to add a note= line."
    printf 'date\t%s\n' "$DATE"
    printf 'imported\t%s\n' "$(date -u +%FT%TZ)"
    printf 'host\t%s\n' "$(uname -sm)"
    # The SHAs below are read at import time. They describe the sweep exactly
    # only when the sweep was taken from this same tree state; a back-dated
    # import may name revisions that postdate the numbers.
    printf 'provenance\t%s\n' "$PROVENANCE"
    echo "#"
    echo "# component<TAB>sha<TAB>describe"
    # Benchmark suites: submodules of this repository.
    printf 'lvx-perf\t%s\n' "$(describe_at "$HERE" benchmark)"
    for b in lvx-mibench lvx-polybench lvx-ssw; do
        printf '%s\t%s\n' "$b" "$(describe_at "$HERE/$b" benchmark)"
    done
    # Toolchain: lvx-csw and its compiler submodules.
    if [ -n "$CSW" ]; then
        printf '# toolchain read from %s (located via %s)\n' "$CSW" "$CSW_FROM"
        printf 'lvx-csw\t%s\n' "$(describe_at "$CSW" toolchain)"
        for c in lvx-mds lvx-binutils lvx-gcc/gcc lvx-llvm/llvm-project \
                 lvx-gem5 lvx-newlib; do
            printf '%s\t%s\n' "$c" "$(describe_at "$CSW/$c" toolchain)"
        done
    else
        echo "# lvx-csw not found at import time -- toolchain revisions unknown."
    fi
} > "$DEST/MANIFEST.new"

# Read the dirt back out of the file: describe_at runs in a command
# substitution, so a flag it set would be lost with its subshell.
#
# This repository's own line is recorded but never gates: lvx-perf holds the
# snapshots and the tools, not an input to the measurement, so an unstaged
# README must not block an import. Everything else is an input.
dirty_inputs() {
    grep -- '-dirty$' "$DEST/MANIFEST.new" | grep -v "^lvx-perf$(printf '\t')"
}

if dirty_inputs | grep -q .; then
    if [ "$ALLOW_DIRTY" != 1 ]; then
        echo "refusing to import: an input tree is dirty, so these numbers" >&2
        echo "cannot be tied to a revision:" >&2
        dirty_inputs | sed 's/^/    /' >&2
        echo "Commit there, or pass --allow-dirty to record the snapshot as" >&2
        echo "unreproducible. Uncommitted results/ do not count as dirty." >&2
        exit 1
    fi
    sed -i 's/^provenance\t.*/provenance\tunreproducible-dirty-tree/' "$DEST/MANIFEST.new"
fi

if [ -z "$CSW" ]; then
    echo "warning: no lvx-csw checkout found (see bin/lvx-csw-path); the" >&2
    echo "         snapshot will" >&2
    echo "         name no compiler revision, which makes it hard to read" >&2
    echo "         later. Continuing." >&2
fi

mv "$DEST/MANIFEST.new" "$DEST/MANIFEST"
trap - EXIT

copied=0
for suite in $SUITES; do
    src="$HERE/lvx-$suite/results"
    if [ ! -d "$src" ]; then
        if [ -d "$HERE/lvx-$suite" ]; then
            echo "  $suite: no results/ -- no TSV harness yet, skipped"
        else
            echo "  $suite: no lvx-$suite submodule -- run git submodule update --init"
        fi
        continue
    fi
    shopt -s nullglob
    files=("$src"/*.tsv)
    shopt -u nullglob
    if [ ${#files[@]} -eq 0 ]; then
        echo "  $suite: results/ is empty -- skipped"
        continue
    fi
    mkdir -p "$DEST/$suite"
    n=0 other=0
    for f in "${files[@]}"; do
        base=$(basename "$f" .tsv)
        # MiBench writes results/<arch>-O<opt>-<date>.tsv, keeping its own
        # history in the filename; PolyBench overwrites one file per config.
        # Strip a trailing date so a config has one stable name here, and keep
        # a self-dated sweep out of any snapshot but its own -- otherwise a
        # single MANIFEST would appear to vouch for sweeps taken weeks apart.
        case "$base" in
            *-[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9])
                fdate=${base: -10}
                config=${base%-"$fdate"}
                if [ "$fdate" != "$DATE" ]; then
                    other=$((other + 1))
                    continue
                fi
                ;;
            *) config=$base ;;
        esac
        # Verbatim copy. The harness TSV is the record; this repository adds
        # provenance and history around it, and never rewrites a number.
        cp -p "$f" "$DEST/$suite/$config.tsv"
        n=$((n + 1))
        copied=$((copied + 1))
    done
    msg="  $suite: $n file(s)"
    [ "$other" -gt 0 ] && msg="$msg ($other self-dated sweep(s) for other dates, skipped)"
    echo "$msg"
    rmdir "$DEST/$suite" 2>/dev/null || true
done

[ "$copied" -gt 0 ] || { echo "nothing imported" >&2; exit 1; }

echo
echo "snapshot: snapshots/$DATE  ($copied TSV file(s))"
echo "review it, then:  git add snapshots/$DATE && git commit"
