#!/usr/bin/env bash
# Part of the LVX project, under the Apache License v2.0 with LLVM Exceptions.
# See LICENSE.TXT in the root of this repository for license information.
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception

# Snapshot a benchmark sweep into snapshots/<date>/, stamped with the revisions
# that produced it.
#
#   ./bin/lvx-perf-import                    # today's date, every suite
#   ./bin/lvx-perf-import --date 2026-10-14  # back-date (use the sweep's date)
#   ./bin/lvx-perf-import --seq 2            # a second sweep the same day
#   ./bin/lvx-perf-import --suite polybench
#   ./bin/lvx-perf-import --note 'why this snapshot is what it is'
#   ./bin/lvx-perf-import --allow-stale   # record stale SHAs anyway
#   ./bin/lvx-perf-import --csw /path/to/lvx-csw
#   LVX_CSW=/path/to/lvx-csw ./bin/lvx-perf-import
#
# The benchmark suites are submodules of THIS repository, so a sweep's results
# are read from ./lvx-<suite>/results. The compilers are not: they live in
# lvx-csw, whose location is a parameter -- see bin/lvx-csw-path for the
# resolution chain, which every tool and harness here shares.
#
# A results TSV on its own is not a performance record. The ISS is
# deterministic, so the same ELF gives the same cycle count forever; a number
# only means something next to the compiler that emitted it. That is what
# MANIFEST carries, and why import refuses to run against a dirty input tree.
#
# provenance values, worst to best:
#
#   stale-toolchain          A TSV names revisions other than the ones
#                            recorded, or names two across one sweep. The
#                            numbers were NOT produced by the stamped
#                            toolchain. Refused unless --allow-stale.
#   unreproducible-dirty-tree  An input tree was dirty, so no revision
#                            identifies what ran. Refused unless --allow-dirty.
#   unverified-stamp         No TSV records what it ran against, so the SHAs
#                            are unproven. Never refused: every TSV written
#                            before bin/lvx-rev-stamp is in this state.
#   as-of-import             Back-dated: the SHAs were read now, not when the
#                            sweep ran, and may postdate it.
#   exact                    The trees are clean, the date is today, and every
#                            TSV's own stamp agrees with what is recorded.
#
# `exact' once meant only that --date was today -- a fact about the clock, not
# about the measurement. bin/lvx-rev-stamp and bin/lvx-stamp-check are what
# make it a checkable claim.

set -euo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

DATE=$(date +%F)
SUITES=""
CSW_ARG=${LVX_CSW:-}
NOTE=${NOTE:-}
ALLOW_DIRTY=${ALLOW_DIRTY:-0}
ALLOW_STALE=0
SEQ=

while [ $# -gt 0 ]; do
    case "$1" in
        --date)        DATE="$2"; shift 2 ;;
        --suite)       SUITES="$SUITES $2"; shift 2 ;;
        --csw)         CSW_ARG="$2"; shift 2 ;;
        --note)        NOTE="$2"; shift 2 ;;
        --csw=*)       CSW_ARG="${1#--csw=}"; shift ;;
        --allow-dirty) ALLOW_DIRTY=1; shift ;;
        --allow-stale) ALLOW_STALE=1; shift ;;
        --seq)         SEQ="$2"; shift 2 ;;
        -h|--help)     sed -n '6,46p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *)             echo "unknown argument: $1" >&2; exit 2 ;;
    esac
done

[ -n "$SUITES" ] || SUITES="polybench mibench ssw turbopfor tsvc2 kernels"

case "$DATE" in
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
    *) echo "--date wants YYYY-MM-DD, got '$DATE'" >&2; exit 2 ;;
esac

# Locate lvx-csw for the toolchain revisions, by the one chain every tool and
# harness here shares: --csw, $LVX_CSW, lvx-csw.path, ../lvx-csw, ~/lvx-csw.
# bin/lvx-csw-path owns it so there is a single place to change it, and a
# single place that documents it.
CSW= CSW_FROM=
if resolved=$("$HERE/bin/lvx-csw-path" --from ${CSW_ARG:+--csw "$CSW_ARG"} 2>/dev/null); then
    CSW=${resolved%%$'\t'*}
    CSW_FROM=${resolved##*$'\t'}
fi

# A component's revision, plus whether its tracked state is dirty. Benchmark
# repositories are asked about their source only: `results/` is this sweep's
# output, and an uncommitted result must not be mistaken for a changed input.
describe_at() {
    local repo=$1 kind=$2 sha desc dirt
    if [ ! -e "$repo/.git" ]; then
        printf 'absent\tabsent\n'
        return
    fi
    sha=$(git -C "$repo" rev-parse HEAD 2>/dev/null || echo unknown)
    desc=$(git -C "$repo" describe --always 2>/dev/null || echo unknown)
    if [ "$kind" = benchmark ]; then
        dirt=$(git -C "$repo" status --porcelain -- . ':(exclude)results' 2>/dev/null | head -1)
    else
        dirt=$(git -C "$repo" status --porcelain 2>/dev/null | head -1)
    fi
    [ -n "$dirt" ] && desc="$desc-dirty"
    printf '%s\t%s\n' "$sha" "$desc"
}

if [ "$DATE" = "$(date +%F)" ]; then
    PROVENANCE=exact
else
    PROVENANCE=as-of-import
fi

case "$SEQ" in
    '') NAME=$DATE ;;
    [2-9]|[1-9][0-9]) NAME=$DATE.$SEQ ;;
    *) echo "--seq wants a number from 2, got '$SEQ'" >&2; exit 2 ;;
esac
DEST="$HERE/snapshots/$NAME"

# A snapshot is immutable, and one MANIFEST vouches for every TSV beside it. A
# second import into the same directory would restamp an earlier sweep's
# numbers with this one's SHAs -- exactly the false provenance this tool exists
# to prevent -- so a second sweep on one day goes beside the first, as
# <date>.<n>, which sorts after it and reads as a column of its own in
# lvx-perf-trend.
if [ -e "$DEST" ]; then
    n=2; while [ -e "$HERE/snapshots/$DATE.$n" ]; do n=$((n + 1)); done
    echo "refusing to import: snapshots/$NAME already exists, and a snapshot is" >&2
    echo "immutable -- importing into it would restamp its numbers with today's" >&2
    echo "SHAs. A second sweep on the same day:  --seq $n  (snapshots/$DATE.$n)" >&2
    exit 1
fi
mkdir -p "$DEST"

# MANIFEST.new is provenance that has not yet been accepted. If this script
# dies or is interrupted before the mv below, it must not survive: a stray
# half-written manifest in a snapshot directory reads like a real record, and
# it is gitignored, so nothing would draw attention to it.
trap 'rm -f "$DEST/MANIFEST.new"; rmdir "$DEST" 2>/dev/null || true' EXIT

{
    echo "# LVX performance snapshot -- provenance for the TSVs beside this file."
    echo "# Written by bin/lvx-perf-import; edit only to add a note= line."
    printf 'date\t%s\n' "$DATE"
    printf 'imported\t%s\n' "$(date -u +%FT%TZ)"
    printf 'host\t%s\n' "$(uname -sm)"
    # The SHAs below are read at import time. They describe the sweep exactly
    # only when the sweep was taken from this same tree state; a back-dated
    # import may name revisions that postdate the numbers.
    printf 'provenance\t%s\n' "$PROVENANCE"
    # provenance is computed from the trees as they are AT IMPORT, which is not
    # always the state that produced the numbers: a tree can be edited after a
    # sweep finishes. The field stays conservative -- a provenance field that
    # errs toward distrust is the only kind worth having -- and a note carries
    # the evidence for a reader who needs the difference.
    [ -n "$NOTE" ] && printf 'note\t%s\n' "$NOTE"
    echo "#"
    if [ "$PROVENANCE" != exact ]; then
        # The SHAs below were read now, not when the sweep ran. Say it HERE,
        # next to them, rather than relying on a reader to look up what
        # provenance=as-of-import implies -- a stamped SHA reads as a fact
        # about the measurement, and for a back-dated import it is not one.
        echo "# WARNING: provenance is $PROVENANCE -- the SHAs below were read at"
        echo "# import time ($(date -u +%FT%TZ)), NOT when these numbers were measured"
        echo "# ($DATE). They may name revisions that postdate the sweep. Do not cite"
        echo "# them as the toolchain that produced these rows without checking."
    fi
    echo "# component<TAB>sha<TAB>describe"
    # Benchmark suites: submodules of this repository.
    printf 'lvx-perf\t%s\n' "$(describe_at "$HERE" benchmark)"
    for b in lvx-kernels lvx-mibench lvx-polybench lvx-ssw lvx-turbopfor lvx-tsvc2; do
        printf '%s\t%s\n' "$b" "$(describe_at "$HERE/$b" benchmark)"
    done
    # Toolchain: lvx-csw and its compiler submodules.
    if [ -n "$CSW" ]; then
        printf '# toolchain read from %s (located via %s)\n' "$CSW" "$CSW_FROM"
        printf 'lvx-csw\t%s\n' "$(describe_at "$CSW" toolchain)"
        for c in lvx-mds lvx-binutils lvx-gcc/gcc lvx-llvm/llvm-project \
                 lvx-gem5 lvx-newlib; do
            printf '%s\t%s\n' "$c" "$(describe_at "$CSW/$c" toolchain)"
        done
    else
        echo "# lvx-csw not found at import time -- toolchain revisions unknown."
    fi
} > "$DEST/MANIFEST.new"

# Read the dirt back out of the file: describe_at runs in a command
# substitution, so a flag it set would be lost with its subshell.
#
# This repository's own line is recorded but never gates: lvx-perf holds the
# snapshots and the tools, not an input to the measurement, so an unstaged
# README must not block an import. Everything else is an input.
dirty_inputs() {
    grep -- '-dirty$' "$DEST/MANIFEST.new" | grep -v "^lvx-perf$(printf '\t')"
}

if dirty_inputs | grep -q .; then
    if [ "$ALLOW_DIRTY" != 1 ]; then
        echo "refusing to import: an input tree is dirty, so these numbers" >&2
        echo "cannot be tied to a revision:" >&2
        dirty_inputs | sed 's/^/    /' >&2
        echo "Commit there, or pass --allow-dirty to record the snapshot as" >&2
        echo "unreproducible. Uncommitted results/ do not count as dirty." >&2
        exit 1
    fi
    sed -i 's/^provenance\t.*/provenance\tunreproducible-dirty-tree/' "$DEST/MANIFEST.new"
fi

# Provenance by evidence rather than by the clock.
#
# `exact' used to be decided by `[ "$DATE" = "$(date +%F)" ]' alone -- a fact
# about the clock, which says nothing about which compiler ran. A sweep taken
# in the morning and imported that evening earned `exact' across a toolchain
# that had turned over twice in between, and no column could have shown it:
# the `toolchain' string (17.0.0 20260627) is a baked version date that
# survives any number of rebuilds. bin/lvx-rev-stamp puts the revisions in the
# TSV at measurement time, so the claim can now be checked instead of assumed.
#
# The source TSVs are read, not the copies: this runs before they are copied,
# and they are identical anyway -- the copy below is verbatim.
shopt -s nullglob
stamp_tsvs=()
for suite in $SUITES; do
    stamp_tsvs+=("$HERE/lvx-$suite/results"/*.tsv)
done
shopt -u nullglob

stamp_out=
stamp_rc=0
if [ ${#stamp_tsvs[@]} -gt 0 ]; then
    stamp_out=$("$HERE/bin/lvx-stamp-check" --manifest "$DEST/MANIFEST.new" \
                ${CSW:+--csw "$CSW"} "${stamp_tsvs[@]}") || stamp_rc=$?
fi

case $stamp_rc in
0)  # Every stamp agreed. This is the only way `exact' is earned.
    ;;
1)  # A stamp disagrees, or changed mid-sweep. These numbers demonstrably were
    # not produced by the revisions about to be recorded, so this refuses by
    # default for the same reason a dirty input tree does: a snapshot whose
    # SHAs are wrong is worse than no snapshot, because it reads as a fact.
    if [ "$ALLOW_STALE" != 1 ]; then
        echo "refusing to import: a result TSV names revisions other than the" >&2
        echo "ones this snapshot would record, so the numbers were not produced" >&2
        echo "by them:" >&2
        printf '%s\n' "$stamp_out" | sed 's/^/    /' >&2
        echo "Re-run the sweep against the current trees, or pass --allow-stale" >&2
        echo "to record the snapshot as stale-toolchain." >&2
        exit 1
    fi
    PROVENANCE=stale-toolchain
    sed -i "s/^provenance\t.*/provenance\t$PROVENANCE/" "$DEST/MANIFEST.new"
    ;;
2)  # Nothing carried a stamp. Not false, just unproven -- every TSV written
    # before bin/lvx-rev-stamp existed is in this state, which is why it never
    # refuses. But it must not be called exact.
    if [ "$PROVENANCE" = exact ]; then
        PROVENANCE=unverified-stamp
        sed -i "s/^provenance\t.*/provenance\t$PROVENANCE/" "$DEST/MANIFEST.new"
    fi
    echo "warning: no result TSV records the revisions it was measured against," >&2
    echo "         so this snapshot's SHAs are unverified. Harnesses get them" >&2
    echo "         from bin/lvx-rev-stamp; lvx-kernels is wired, the rest are not." >&2
    # Print the detail only: the KIND and the path are for a caller parsing
    # the output, and the path on a NEWER line names this manifest rather than
    # any result file, which would read as though the manifest were at fault.
    printf '%s\n' "$stamp_out" | awk -F'\t' '$1 == "NEWER" { print "         " $3 }' >&2
    ;;
esac

if [ -z "$CSW" ]; then
    echo "warning: no lvx-csw checkout found (see bin/lvx-csw-path); the" >&2
    echo "         snapshot will" >&2
    echo "         name no compiler revision, which makes it hard to read" >&2
    echo "         later. Continuing." >&2
fi

mv "$DEST/MANIFEST.new" "$DEST/MANIFEST"
trap - EXIT

copied=0
for suite in $SUITES; do
    src="$HERE/lvx-$suite/results"
    if [ ! -d "$src" ]; then
        if [ -d "$HERE/lvx-$suite" ]; then
            echo "  $suite: no results/ -- no TSV harness yet, skipped"
        else
            echo "  $suite: no lvx-$suite submodule -- run git submodule update --init"
        fi
        continue
    fi
    shopt -s nullglob
    files=("$src"/*.tsv)
    shopt -u nullglob
    if [ ${#files[@]} -eq 0 ]; then
        echo "  $suite: results/ is empty -- skipped"
        continue
    fi
    mkdir -p "$DEST/$suite"
    n=0 other=0
    for f in "${files[@]}"; do
        base=$(basename "$f" .tsv)
        # MiBench writes results/<arch>-O<opt>-<date>.tsv, keeping its own
        # history in the filename; PolyBench overwrites one file per config.
        # Strip a trailing date so a config has one stable name here, and keep
        # a self-dated sweep out of any snapshot but its own -- otherwise a
        # single MANIFEST would appear to vouch for sweeps taken weeks apart.
        case "$base" in
            *-[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9])
                fdate=${base: -10}
                config=${base%-"$fdate"}
                if [ "$fdate" != "$DATE" ]; then
                    other=$((other + 1))
                    continue
                fi
                ;;
            *) config=$base ;;
        esac
        # Verbatim copy. The harness TSV is the record; this repository adds
        # provenance and history around it, and never rewrites a number.
        cp -p "$f" "$DEST/$suite/$config.tsv"
        n=$((n + 1))
        copied=$((copied + 1))
    done
    msg="  $suite: $n file(s)"
    [ "$other" -gt 0 ] && msg="$msg ($other self-dated sweep(s) for other dates, skipped)"
    echo "$msg"
    rmdir "$DEST/$suite" 2>/dev/null || true
done

[ "$copied" -gt 0 ] || { echo "nothing imported" >&2; exit 1; }

echo
echo "snapshot: snapshots/$NAME  ($copied TSV file(s))"
echo "review it, then:  git add snapshots/$NAME && git commit"
